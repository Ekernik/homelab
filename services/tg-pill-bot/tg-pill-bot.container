[Unit]
Description=Personal Telegram Bot for daily tracking of supplements and prescriptions.
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/ekernik/pill_bot_telegram:latest
ContainerName=tg-pill-bot
EnvironmentFile=bot.env
AutoUpdate=registry
Timezone=local
Network=host
Volume=/home/ekernik/tg-pill-bot/data:/data:Z
User=0

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target